{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/fxrdhan/lez/main/docs/theme-schema.json",
    "title": "lez theme",
    "$defs": {
        "color": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": [
                        "string"
                    ],
                    "enum": [
                        "",
                        "default",
                        "Default",
                        "black",
                        "Black",
                        "darkgray",
                        "DarkGray",
                        "red",
                        "Red",
                        "lightred",
                        "LightRed",
                        "green",
                        "Green",
                        "lightgreen",
                        "LightGreen",
                        "yellow",
                        "Yellow",
                        "lightyellow",
                        "LightYellow",
                        "blue",
                        "Blue",
                        "lightblue",
                        "LightBlue",
                        "purple",
                        "Purple",
                        "lightpurple",
                        "LightPurple",
                        "magenta",
                        "Magenta",
                        "lightmagenta",
                        "LightMagenta",
                        "cyan",
                        "Cyan",
                        "lightcyan",
                        "LightCyan",
                        "white",
                        "White",
                        "lightgray",
                        "LightGray"
                    ]
                },
                {
                    "type": [
                        "string"
                    ],
                    "pattern": "^(#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})|[0-9]{2})$"
                }
            ]
        },
        "style": {
            "type": "object",
            "properties": {
                "foreground": {
                    "$ref": "#/$defs/color"
                },
                "background": {
                    "$ref": "#/$defs/color"
                },
                "is_bold": {
                    "type": "boolean"
                },
                "is_dimmed": {
                    "type": "boolean"
                },
                "is_italic": {
                    "type": "boolean"
                },
                "is_underline": {
                    "type": "boolean"
                },
                "is_blink": {
                    "type": "boolean"
                },
                "is_reverse": {
                    "type": "boolean"
                },
                "is_hidden": {
                    "type": "boolean"
                },
                "is_strikethrough": {
                    "type": "boolean"
                },
                "prefix_with_reset": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "icon": {
            "properties": {
                "glyph": {
                    "type": "string",
                    "pattern": "^.$"
                },
                "style": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "git_status": {
            "type": "object",
            "properties": {
                "glyph": {
                    "type": "string"
                },
                "foreground": {
                    "$ref": "#/$defs/color"
                },
                "background": {
                    "$ref": "#/$defs/color"
                },
                "is_bold": {
                    "type": "boolean"
                },
                "is_dimmed": {
                    "type": "boolean"
                },
                "is_italic": {
                    "type": "boolean"
                },
                "is_underline": {
                    "type": "boolean"
                },
                "is_blink": {
                    "type": "boolean"
                },
                "is_reverse": {
                    "type": "boolean"
                },
                "is_hidden": {
                    "type": "boolean"
                },
                "is_strikethrough": {
                    "type": "boolean"
                },
                "prefix_with_reset": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        }
    },
    "description": "Eza theme config file",
    "type": "object",
    "properties": {
        "filekinds": {
            "properties": {
                "normal": {
                    "$ref": "#/$defs/style"
                },
                "directory": {
                    "$ref": "#/$defs/style"
                },
                "symlink": {
                    "description": "A style, or the literal \"target\" to borrow the pointed-to file's colour",
                    "oneOf": [
                        {
                            "$ref": "#/$defs/style"
                        },
                        {
                            "type": "string",
                            "const": "target"
                        }
                    ]
                },
                "pipe": {
                    "$ref": "#/$defs/style"
                },
                "block_device": {
                    "$ref": "#/$defs/style"
                },
                "char_device": {
                    "$ref": "#/$defs/style"
                },
                "socket": {
                    "$ref": "#/$defs/style"
                },
                "special": {
                    "$ref": "#/$defs/style"
                },
                "executable": {
                    "$ref": "#/$defs/style"
                },
                "mount_point": {
                    "$ref": "#/$defs/style"
                },
                "btrfs_subvol": {
                    "$ref": "#/$defs/style",
                    "description": "Colour for directories representing Btrfs subvolumes."
                }
            },
            "additionalProperties": false
        },
        "perms": {
            "properties": {
                "user_read": {
                    "$ref": "#/$defs/style"
                },
                "user_write": {
                    "$ref": "#/$defs/style"
                },
                "user_execute_file": {
                    "$ref": "#/$defs/style"
                },
                "user_execute_other": {
                    "$ref": "#/$defs/style"
                },
                "group_read": {
                    "$ref": "#/$defs/style"
                },
                "group_write": {
                    "$ref": "#/$defs/style"
                },
                "group_execute": {
                    "$ref": "#/$defs/style"
                },
                "other_read": {
                    "$ref": "#/$defs/style"
                },
                "other_write": {
                    "$ref": "#/$defs/style"
                },
                "other_execute": {
                    "$ref": "#/$defs/style"
                },
                "special_user_file": {
                    "$ref": "#/$defs/style"
                },
                "special_other": {
                    "$ref": "#/$defs/style"
                },
                "attribute": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "size": {
            "properties": {
                "major": {
                    "$ref": "#/$defs/style"
                },
                "minor": {
                    "$ref": "#/$defs/style"
                },
                "number_byte": {
                    "$ref": "#/$defs/style"
                },
                "number_kilo": {
                    "$ref": "#/$defs/style"
                },
                "number_mega": {
                    "$ref": "#/$defs/style"
                },
                "number_giga": {
                    "$ref": "#/$defs/style"
                },
                "number_huge": {
                    "$ref": "#/$defs/style"
                },
                "unit_byte": {
                    "$ref": "#/$defs/style"
                },
                "unit_kilo": {
                    "$ref": "#/$defs/style"
                },
                "unit_mega": {
                    "$ref": "#/$defs/style"
                },
                "unit_giga": {
                    "$ref": "#/$defs/style"
                },
                "unit_huge": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "users": {
            "properties": {
                "user_you": {
                    "$ref": "#/$defs/style"
                },
                "user_root": {
                    "$ref": "#/$defs/style"
                },
                "user_other": {
                    "$ref": "#/$defs/style"
                },
                "group_yours": {
                    "$ref": "#/$defs/style"
                },
                "group_other": {
                    "$ref": "#/$defs/style"
                },
                "group_root": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "links": {
            "properties": {
                "normal": {
                    "$ref": "#/$defs/style"
                },
                "multi_link_file": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "git": {
            "properties": {
                "new": {
                    "$ref": "#/$defs/git_status"
                },
                "modified": {
                    "$ref": "#/$defs/git_status"
                },
                "deleted": {
                    "$ref": "#/$defs/git_status"
                },
                "renamed": {
                    "$ref": "#/$defs/git_status"
                },
                "typechange": {
                    "$ref": "#/$defs/git_status"
                },
                "ignored": {
                    "$ref": "#/$defs/git_status"
                },
                "conflicted": {
                    "$ref": "#/$defs/git_status"
                },
                "not_modified": {
                    "$ref": "#/$defs/git_status"
                }
            },
            "additionalProperties": false
        },
        "git_repo": {
            "properties": {
                "branch_main": {
                    "$ref": "#/$defs/git_status"
                },
                "branch_other": {
                    "$ref": "#/$defs/git_status"
                },
                "branch_worktree": {
                    "$ref": "#/$defs/git_status"
                },
                "git_clean": {
                    "$ref": "#/$defs/git_status"
                },
                "git_dirty": {
                    "$ref": "#/$defs/git_status"
                }
            },
            "additionalProperties": false
        },
        "security_context": {
            "properties": {
                "none": {
                    "$ref": "#/$defs/style"
                },
                "selinux": {
                    "type": "object",
                    "properties": {
                        "colon": {
                            "$ref": "#/$defs/style"
                        },
                        "user": {
                            "$ref": "#/$defs/style"
                        },
                        "role": {
                            "$ref": "#/$defs/style"
                        },
                        "typ": {
                            "$ref": "#/$defs/style"
                        },
                        "range": {
                            "$ref": "#/$defs/style"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "file_type": {
            "properties": {
                "image": {
                    "$ref": "#/$defs/style"
                },
                "video": {
                    "$ref": "#/$defs/style"
                },
                "music": {
                    "$ref": "#/$defs/style"
                },
                "lossless": {
                    "$ref": "#/$defs/style"
                },
                "crypto": {
                    "$ref": "#/$defs/style"
                },
                "document": {
                    "$ref": "#/$defs/style"
                },
                "compressed": {
                    "$ref": "#/$defs/style"
                },
                "temp": {
                    "$ref": "#/$defs/style"
                },
                "compiled": {
                    "$ref": "#/$defs/style"
                },
                "build": {
                    "$ref": "#/$defs/style"
                },
                "source": {
                    "$ref": "#/$defs/style"
                },
                "data": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        },
        "punctuation": {
            "$ref": "#/$defs/style"
        },
        "date": {
            "$ref": "#/$defs/style"
        },
        "inode": {
            "$ref": "#/$defs/style"
        },
        "blocks": {
            "$ref": "#/$defs/style"
        },
        "header": {
            "$ref": "#/$defs/style"
        },
        "octal": {
            "$ref": "#/$defs/style"
        },
        "flags": {
            "$ref": "#/$defs/style"
        },
        "quote": {
            "$ref": "#/$defs/style"
        },
        "control_char": {
            "$ref": "#/$defs/style"
        },
        "broken_symlink": {
            "$ref": "#/$defs/style"
        },
        "broken_path_overlay": {
            "$ref": "#/$defs/style"
        },
        "filenames": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "properties": {
                        "filename": {
                            "$ref": "#/$defs/style"
                        },
                        "icon": {
                            "$ref": "#/$defs/icon"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "extensions": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "filename": {
                        "$ref": "#/$defs/style"
                    },
                    "icon": {
                        "$ref": "#/$defs/icon"
                    }
                }
            },
            "additionalProperties": false
        },
        "directorynames": {
            "description": "Per-directoryname icon and colour overrides.",
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "properties": {
                        "filename": {
                            "$ref": "#/$defs/style"
                        },
                        "icon": {
                            "$ref": "#/$defs/icon"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "mimetypes": {
            "description": "Per-mimetype icon and colour overrides.",
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "properties": {
                        "filename": {
                            "$ref": "#/$defs/style"
                        },
                        "icon": {
                            "$ref": "#/$defs/icon"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "symlink_path": {
            "$ref": "#/$defs/style"
        },
        "tags": {
            "description": "Finder-tag colours.",
            "type": "object",
            "properties": {
                "none": {
                    "$ref": "#/$defs/style"
                },
                "grey": {
                    "$ref": "#/$defs/style"
                },
                "green": {
                    "$ref": "#/$defs/style"
                },
                "purple": {
                    "$ref": "#/$defs/style"
                },
                "blue": {
                    "$ref": "#/$defs/style"
                },
                "yellow": {
                    "$ref": "#/$defs/style"
                },
                "red": {
                    "$ref": "#/$defs/style"
                },
                "orange": {
                    "$ref": "#/$defs/style"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
